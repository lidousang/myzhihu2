server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Copy the Vite production build to this directory.
    root /var/www/myzhihu/frontend/dist;
    index index.html;

    # No URI suffix on proxy_pass means /api/... is forwarded unchanged to Gin.
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # Vue Router uses HTML5 history URLs such as /question/123 and /register.
    # Serve static assets when present and use the SPA entry for client routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
